# Google Analytics 4 Measurement ID (format: G-XXXXXXXXXX)
VITE_GA_MEASUREMENT_ID=

# Microsoft Clarity Project ID
VITE_CLARITY_PROJECT_ID=

# Web3Forms access key for the Contacto page form (get one at https://web3forms.com,
# no account needed — it emails you the key tied to the destination inbox).
# This key is meant to be public/client-side, not a secret.
VITE_WEB3FORMS_ACCESS_KEY=
