{
  "permissions": {
    "allow": [
      "Bash(npm run lint *)",
      "Bash(npm run dev *)",
      "Bash(npm run preview *)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(rm -r *)",
      "Bash(rm -R *)",
      "Bash(rm --recursive *)",
      "Bash(rmdir *)",
      "Bash(sudo rm -rf *)",
      "Bash(sudo rm -r *)",
      "Bash(sudo rmdir *)",
      "Bash(git clean *)"
    ],
    "defaultMode": "bypassPermissions"
  }
}
